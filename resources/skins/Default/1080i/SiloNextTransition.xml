<?xml version="1.0" encoding="UTF-8"?>
<!-- Covers the screen while Play next hands over to the following episode (ui_overlay.NextTransition). -->
<window type="dialog">
  <defaultcontrol always="true">100</defaultcontrol>
  <coordinates><left>0</left><top>0</top></coordinates>
  <animation effect="fade" start="0" end="100" time="150">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="200">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="FF000000">white.png</texture>
    </control>
    <control type="label">
      <left>0</left><top>430</top><width>1920</width><height>30</height>
      <font>font10</font><textcolor>B3EDEDED</textcolor><align>center</align><label>UP NEXT</label>
    </control>
    <control type="label">
      <left>0</left><top>466</top><width>1920</width><height>34</height>
      <font>font12</font><textcolor>BFEDEDED</textcolor><align>center</align>
      <label>$INFO[Window.Property(silo.next_eyebrow)]</label>
    </control>
    <control type="label">
      <left>160</left><top>506</top><width>1600</width><height>64</height>
      <font>font36_title</font><textcolor>FFEDEDED</textcolor><align>center</align>
      <label>$INFO[Window.Property(silo.next_title)]</label>
    </control>
    <control type="label">
      <left>0</left><top>600</top><width>1920</width><height>34</height>
      <font>font12</font><textcolor>B3EDEDED</textcolor><align>center</align><label>Starting…</label>
      <animation effect="fade" start="100" end="35" time="900" pulse="true" condition="true">Conditional</animation>
    </control>
    <!-- Takes focus so keys reach this card, not the screen beneath; it draws nothing. -->
    <control type="button" id="100">
      <left>0</left><top>0</top><width>1</width><height>1</height>
      <label></label><texturefocus></texturefocus><texturenofocus></texturenofocus>
    </control>
  </controls>
</window>
